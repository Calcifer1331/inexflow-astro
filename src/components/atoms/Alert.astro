---
interface Props {
    type?:
        | "primary"
        | "secundary"
        | "success"
        | "info"
        | "dark"
        | "light"
        | "warning"
        | "danger";
}
let { type = "primary" } = Astro.props as Props;
---

<div
    class:list={["alert alert-dismissible fade show", `alert-${type}`]}
    role="alert"
>
    <slot />
    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Cerrar"></button>
</div>
