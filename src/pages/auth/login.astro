---
import Layout from "@lay/Default.astro";
import FieldText from "@comp/FieldText.astro";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";
import Alert from "@/components/Alert.astro";

const result = Astro.getActionResult(actions.auth.login);

if (result && !result.error && result.data.success) {
    return Astro.redirect(result.data.message);
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {};
---

<Layout title="Login">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="card-title text-center mb-4">
                            Iniciar Sesión
                        </h2>
                        {
                            result &&
                                (result.error || !result.data.success) && (
                                    <Alert type="danger">
                                        {result.error
                                            ? "Error al iniciar session!!"
                                            : result.data.message}
                                    </Alert>
                                )
                        }
                        <form
                            method="POST"
                            id="login-form"
                            action={actions.auth.login}
                            class="needs-validation"
                            novalidate
                        >
                            <FieldText
                                label="Correo"
                                type="email"
                                name="email"
                                placeholder="name@example.com"
                                errors={inputErrors.email}
                                min="1"
                                max="250"
                                required
                            />
                            <FieldText
                                label="Contraseña"
                                type="password"
                                name="password"
                                placeholder="4fmv5yvtjgft"
                                errors={inputErrors.password}
                                min="8"
                                max="250"
                                required
                            />
                        </form>

                        <div class="d-flex justify-content-end mb-3">
                            <a href="#" class="text-decoration-none"
                                >¿Olvidó su contraseña?
                            </a>
                        </div>

                        <button
                            type="submit"
                            form="login-form"
                            class="btn btn-primary w-100 py-2"
                        >
                            Acceder
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="img-bg"></div>
</Layout>

<style>
    .img-bg {
        position: absolute;
        inset: 0px;
        z-index: -10;
        background-image: url("/assets/img/login-bg.avif");
        background-position: center;
        background-repeat: no-repeat;
        filter: blur(2px);
        background-size: 100%;
    }
</style>
