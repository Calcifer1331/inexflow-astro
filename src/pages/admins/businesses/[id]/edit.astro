---
import Layout from "@/layouts/Layout.astro";
import { findById } from "@/lib/server/db/business.repository";
import { dateFormatter } from "@helper/format";
import FieldText from "@/components/FieldText.astro";
import { UUIDParser } from "@/lib/schemas/common.schema";
const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "admin")
    return new Response(null, { status: 403 });

const businessId = UUIDParser.safeParse(Astro.params.id);

if (businessId.error) return new Response(null, { status: 404 });

const business = await findById(businessId.data);

if (!business) return new Response(null, { status: 404 });
---

<Layout title="Negocio">
    <div class="row">
        <div class="col-12 col-md-6">
            <FieldText label="Nombre" name="name" value={business.name} />
            <FieldText
                label="Numero de Telefono"
                type="tel"
                name="phone"
                value={business.phone}
            />
        </div>
        <div class="col-12 col-md-6">
            <FieldText
                label="Fecha de Creación"
                value={dateFormatter.format(business.createdAt)}
                disabled
                readonly
            />
            <FieldText
                label="Fecha de Actualización"
                value={dateFormatter.format(business.updatedAt)}
                disabled
                readonly
            />
        </div>
    </div>
</Layout>
