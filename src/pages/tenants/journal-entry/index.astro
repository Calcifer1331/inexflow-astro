---
import Alert from "@comp/Alert.astro";
import FieldText from "@comp/FieldText.astro";
import Layout from "@lay/Layout.astro";
import JournalEntryForm from "@mod/journal/JournalEntryForm.svelte";
import { isInputError, actions } from "astro:actions";
import { accountTypeOptions } from "@schema/account.schema";
import SelectField from "@comp/SelectField.astro";
import { journalCodeFormatter } from "@helper/journal";
import { findLastJournalEntryCode } from "@db/journal_entry.repository";
import { shortDateFormatter, systemDateFormatter } from "@/lib/helpers/format";
const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "businessman")
    return new Response(null, { status: 403 });

const result = Astro.getActionResult(actions.journalEntry.create);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};

const lastJournalCode = await findLastJournalEntryCode(
    authenticatedUser.businessId,
);
---

<Layout title="Entrada de Diario">
    {
        result &&
            (result.error ? (
                !isInputError(result?.error) ? (
                    <Alert type="danger">{result.error.message}</Alert>
                ) : (
                    inputErrors.records && (
                        <Alert type="danger">
                            <ul>
                                {inputErrors.records.map((e) => (
                                    <li>{e}</li>
                                ))}
                            </ul>
                        </Alert>
                    )
                )
            ) : (
                result.data && (
                    <Alert type="success">
                        Entrada {result.data.code} creada exitosa mente.
                    </Alert>
                )
            ))
    }
    <JournalEntryForm client:load transition:persists {lastJournalCode} />
</Layout>
