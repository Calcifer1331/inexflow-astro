---
import Alert from "@comp/Alert.astro";
import FieldText from "@comp/FieldText.astro";
import Layout from "@lay/Layout.astro";
import RecordsGrud from "@mod/journal/RecordsGrud.svelte";
import { isInputError, actions } from "astro:actions";
import { accountTypeOptions } from "@schema/account.schema";
import SelectField from "@comp/SelectField.astro";
import { journalCodeFormatter } from "@helper/journal";
import { findLastJournalEntryCode } from "@db/journal_entry.repository";
import { shortDateFormatter, systemDateFormatter } from "@/lib/helpers/format";
const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "businessman")
    return new Response(null, { status: 403 });

const result = Astro.getActionResult(actions.journalEntry.create);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};

const lastJournalCode = await findLastJournalEntryCode(
    authenticatedUser.businessId,
);
const thisDate = new Date(Date.now());
const post = Astro.request.method === "POST";
const formData = post ? await Astro.request.formData() : null;
---

<Layout title="Entrada de Diario">
    {
        result &&
            (result.error ? (
                !isInputError(result?.error) ? (
                    <Alert type="danger">{result.error.message}</Alert>
                ) : (
                    inputErrors.records && (
                        <Alert type="danger">
                            <ul>
                                {inputErrors.records.map((e) => (
                                    <li>{e}</li>
                                ))}
                            </ul>
                        </Alert>
                    )
                )
            ) : (
                result.data && (
                    <Alert type="success">
                        Entrada {result.data.code} creada exitosa mente.
                    </Alert>
                )
            ))
    }
    <form
        action={actions.journalEntry.create}
        method="POST"
        class="needs-validation"
        id="journal-form"
        novalidate
    >
        <div class="row">
            <div class="col-12 col-md-6">
                <FieldText
                    label="Nombre"
                    type="text"
                    name="name"
                    min="2"
                    max="250"
                    required
                    errors={inputErrors.name}
                />

                <FieldText
                    label="Descripción"
                    type="text"
                    name="description"
                    min="2"
                    max="250"
                    required
                    errors={inputErrors.description}
                />
            </div>
            <div class="col-12 col-md-6">
                <FieldText
                    label="Código"
                    type="text"
                    readonly
                    disabled
                    value={journalCodeFormatter.format(
                        lastJournalCode,
                        thisDate.getFullYear(),
                    )}
                />
                <FieldText
                    label="Fecha"
                    type="date"
                    name="date"
                    required
                    value={systemDateFormatter.formatInput(thisDate)}
                    errors={inputErrors.date}
                />
                <!-- <SelectField
                    label="Subtipo de Cuentas"
                    name="accountSubtypeId"
                    errors={inputErrors.accountSubtypeId}
                    options={accountsSubtype.map(
                        ({ id, name, accountType, code }) => ({
                            value: id,
                            text: `${accountTypeOptions[accountType]}| ${code} | ${name}`,
                        }),
                    )}
                /> -->
            </div>
        </div>

        <RecordsGrud client:load transition:persist />
        <div class="row">
            <div class="d-grid">
                <button
                    type="submit"
                    form="journal-form"
                    class="btn btn-success mx-auto"
                    style="width: 35%;">Registrar</button
                >
            </div>
        </div>
    </form>
</Layout>
