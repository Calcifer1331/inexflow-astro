---
import Alert from "@/components/Alert.astro";
import FieldText from "@/components/FieldText.astro";
import Layout from "@/layouts/Layout.astro";
import { isInputError, actions } from "astro:actions";
import { type ItemType } from "@lib/schemas/item.schema";
import SelectField from "@/components/SelectField.astro";
import { findAll } from "@/lib/server/db/measureUnit.respository";
const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "businessman")
    return new Response(null, { status: 403 });

const result = Astro.getActionResult(actions.item.create);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};

const measureUnits = await findAll();
---

<Layout title="Producto">
    {
        result && result.error && !isInputError(result?.error) && (
            <Alert type="danger">{result.error.message}</Alert>
        )
    }
    {
        result && result.data && (
            <Alert type="success">
                Producto {result.data.name} creado exitosa mente.
            </Alert>
        )
    }
    <form
        action={actions.item.create}
        method="POST"
        class="needs-validation"
        novalidate
    >
        <div class="row">
            <input type="hidden" name="type" value={"product" as ItemType} />
            <div class="col-12 col-md-6">
                <FieldText
                    label="Nombre"
                    type="text"
                    name="name"
                    min="5"
                    max="250"
                    required
                    errors={inputErrors.name}
                />
                <FieldText
                    label="Costo"
                    type="number"
                    name="cost"
                    min="0.00"
                    step="0.01"
                    required
                    errors={inputErrors.cost}
                />
                <FieldText
                    label="Precio de Venta"
                    type="number"
                    name="sellingPrice"
                    min="0.00"
                    step="0.01"
                    errors={inputErrors.sellingPrice}
                />
            </div>
            <div class="col-12 col-md-6">
                <FieldText
                    label="Stock"
                    type="number"
                    name="stock"
                    min="1"
                    required
                    errors={inputErrors.stock}
                />
                <FieldText
                    label="Stock minimo"
                    type="number"
                    name="minStock"
                    min="1"
                    errors={inputErrors.minStock}
                />
                <!-- <FieldText
                    label="Measure Unir"
                    type="number"
                    name="measureUnitId"
                    min="1"
                    /> -->
                <SelectField
                    label="Unidad de medida"
                    name="measureUnitId"
                    errors={inputErrors.measureUnitId}
                    options={measureUnits.map(({ id, value }) => ({
                        value: id,
                        text: value,
                    }))}
                />
            </div>

            <div class="d-grid">
                <button
                    type="submit"
                    class="btn btn-success mx-auto"
                    style="width: 35%;">Registrar</button
                >
            </div>
        </div>
    </form>
</Layout>
