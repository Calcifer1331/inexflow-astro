---
import ActionButton from "@/components/ActionButton.astro";
import Alert from "@/components/Alert.astro";
import Layout from "@/layouts/Layout.astro";
import { currencyFormatter } from "@/lib/helpers/format";
import { type ItemType } from "@/lib/server/db/schema";
import { findAllByBusinessIdAndType } from "@/lib/server/db/item.repository";
import { actions, isInputError } from "astro:actions";
import DeleteModal from "@mod/CRUD/DeleteModal.astro";
import Table from "@mod/CRUD/Table.astro";
import ActionButtons from "@mod/CRUD/ActionButtons.astro";

const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "businessman")
    return new Response(null, { status: 403 });

const products = await findAllByBusinessIdAndType(
    authenticatedUser.businessId,
    "product",
);

let alertProducts:{name:string,id:number,type:'danger'|'warning'}[] =[];

products.forEach(({minStock,stock,name,id})=>{
    if(stock<minStock)return alertProducts.push({id,name,type:'danger'});
    else if(stock===minStock)return alertProducts.push({id,name,type:'warning'});
})

const deleteResult = Astro.getActionResult(actions.item.delete);

const sectionName="producto";

---

<Layout title="Productos">
    {
        deleteResult && deleteResult.error && (
            <Alert type="danger">
                {isInputError(deleteResult?.error) ? (
                    <span>Error al eliminar el producto:</span>
                    <ul class="mb-0">
                    {
                        Object.values(deleteResult.error.fields).map((values) =>
                            values.map((error) => <li>{error}</li>),
                        )
                    }
                    </ul>
                ) : (
                    <span>Error al eliminar el producto!!</span>
                )}
            </Alert>
        )
    }
    {
        deleteResult && deleteResult.data?.success && (
            <Alert type="success">Producto eliminado exitosamente!!</Alert>
        )
    }

    <ActionButton action="new" href="/tenants/products/new">
        Agregar Productos
    </ActionButton>
    <Table>
        <Fragment slot='head'>
            <th></th>
                <th>Nombre</th>
                    <th>Costo</th>
                    <th>Precio de Venta</th>
                    <th>Cantidad</th>
                    <th>Acciones</th>
        </Fragment>
        <Fragment slot='body'>
                    {products.length ? (
                        products.map(({cost,id,name,sellingPrice,stock,measureUnit,},i) => (
                                <tr>
                                    <td>{i + 1}</td>
                                    <td>{name}</td>
                                    <td>
                                        {currencyFormatter.format(parseFloat(cost))}
                                    </td>
                                    <td>
                                        {sellingPrice ? currencyFormatter.format(parseFloat(sellingPrice)): "--"}
                                    </td>
                                    <td>
                                        {parseFloat(stock)} {measureUnit?.symbol}
                                    </td>
                                    <td>
                                        <ActionButtons {id} {name} segment="tenants/products"/>
                                    </td>
                                </tr>
                            ),
                        )
                    ) : (
                        <tr>
                            <td colspan="9" class="text-center">
                                No hay {sectionName} registrados.
                            </td>
                        </tr>
                    )
                }
        </Fragment>
    </Table>
    <DeleteModal action={actions.item.delete} {sectionName}>
        <Fragment slot='delete-form'>
            <input type="hidden" name="type" value="product">
        </Fragment>
    </DeleteModal>
    {
        alertProducts.length &&
            alertProducts.map(({ id, name,type }) => (
                <Alert {type}>
                    Alerta!!, {" "}
                    <a href={`/tenants/products/${id}`} class="alert-link">
                        {name}
                    </a>{" "}
                    {type==='danger'?'esta por debajo del limite':'esta serca del limite'}
                </Alert>
            ))
    }
</Layout>
