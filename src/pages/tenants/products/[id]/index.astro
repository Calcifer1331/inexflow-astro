---
import ActionButton from "@atom/ActionButton.astro";
import Alert from "@atom/Alert.astro";
import Layout from "@/layouts/Layout.astro";
import { currencyFormatter, dateFormatter } from "@/lib/helpers/format";
import { findByIdAndBusinessIdAndTypeForShow } from "@/lib/server/db/item.repository";
import { findAllOfItemByOuyputIdByBusinessIdAndType } from "@/lib/server/db/recipe.repository";

const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "businessman")
    return new Response(null, { status: 403 });

const parseId = parseInt(Astro.params.id ?? "0");

if (!parseId) return new Response(null, { status: 404 });

const product = await findByIdAndBusinessIdAndTypeForShow(
    parseId,
    authenticatedUser.businessId,
    "product",
);

if (!product) return new Response(null, { status: 404 });

const {
    cost,
    minStock,
    name,
    sellingPrice,
    stock,
    createdAt,
    updatedAt,
    measureUnit,
} = product;

const recipes = await findAllOfItemByOuyputIdByBusinessIdAndType(
    parseId,
    authenticatedUser.businessId,
);
---

<Layout title="Producto">
    <pre>
        <!-- {JSON.stringify(recipes,null,2)} -->
    </pre>
    <h1>{name}</h1>
    <p><strong>Identificador:</strong> {parseId}</p>
    <p><strong>Costo:</strong> {currencyFormatter.format(parseFloat(cost))}</p>
    <p>
        <strong>Presio de Venta:</strong>
        {
            sellingPrice
                ? currencyFormatter.format(parseFloat(sellingPrice))
                : "--"
        }
    </p>
    <p>
        <strong>Cantidad en Inventario:</strong>
        {parseFloat(stock)}
        {measureUnit.symbol}
    </p>
    <p>
        <strong>Cantidad Minima en Inventario:</strong>
        {parseFloat(minStock)}
        {measureUnit.symbol}
    </p>
    <p>
        <strong>Creado:</strong>
        {dateFormatter.format(createdAt)}
    </p>
    <p>
        <strong>Ultima actualizacion:</strong>
        {dateFormatter.format(updatedAt)}
    </p>
    <ActionButton action="edit" href=`/tenants/products/${parseId}/edit`>
        Editar
    </ActionButton>
    <hr />
    <h3>Recetas del Producto</h3>
    {
        !recipes.length ? (
            <Alert type="info">No tiene recetas</Alert>
        ) : (
            <div class="container text-center">
                <div class="row">
                    {recipes.map(({ components }, i) => {
                        let total = 0;
                        return (
                            <div class="col col-md-auto p-2">
                                <div class="rounded-4 bg-info-subtle p-4 mb-0">
                                    <h6>Receta {i + 1}</h6>
                                    <table class="table table-info table-striped-columns ">
                                        <thead>
                                            <tr>
                                                <th scope="col">Nombre</th>
                                                <th scope="col">Cantidad</th>
                                                <th scope="col">Precio</th>
                                                <th scope="col">SubTotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {components.map(
                                                ({
                                                    cost,
                                                    name,
                                                    measureUnitSymbol,
                                                    quantity,
                                                }) => {
                                                    const parseCost =
                                                        parseFloat(cost ?? "0");
                                                    const parseQuantity =
                                                        parseFloat(
                                                            quantity ?? "0",
                                                        );
                                                    const subtotal =
                                                        parseCost *
                                                        parseQuantity;
                                                    total += subtotal;
                                                    return (
                                                        <tr>
                                                            <td>{name} </td>
                                                            <td>
                                                                {parseQuantity}{" "}
                                                                {
                                                                    measureUnitSymbol
                                                                }
                                                            </td>
                                                            <td>
                                                                {currencyFormatter.format(
                                                                    parseCost,
                                                                )}
                                                            </td>
                                                            <td>
                                                                {currencyFormatter.format(
                                                                    subtotal,
                                                                )}
                                                            </td>
                                                        </tr>
                                                    );
                                                },
                                            )}
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td>Total</td>
                                                <td />
                                                <td />
                                                <td>
                                                    {currencyFormatter.format(
                                                        total,
                                                    )}
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        )
    }
</Layout>
