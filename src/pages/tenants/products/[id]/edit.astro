---
import Alert from "@atom/Alert.astro";
import FieldText from "@atom/FieldText.astro";
import Layout from "@lay/Layout.astro";
import { findByIdAndBusinessIdAndTypeForEdit } from "@db/item.repository";
import { isInputError, actions } from "astro:actions";
import { type ItemType } from "@schema/item.schema";
import { findAll } from "@db/measure_unit.repository";
import SelectField from "@atom/SelectField.astro";
const { authenticatedUser } = Astro.locals;

if (authenticatedUser.role !== "businessman")
    return new Response(null, { status: 403 });

const parseId = parseInt(Astro.params.id ?? "0");

if (!parseId) return new Response(null, { status: 404 });

const [product,measureUnits] = await Promise.all([
    findByIdAndBusinessIdAndTypeForEdit(parseId,authenticatedUser.businessId,"product") ,
    findAll()
]);

const result = Astro.getActionResult(actions.item.edit);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};

if (!product) return new Response(null, { status: 404 });

const { cost, minStock, name, measureUnitId, sellingPrice, stock } = product;
---

<Layout title="Producto">
    {
        result && result.error && (
            <Alert type="danger">
                    {!isInputError(result?.error) ? (
                        result.error.message
                    ) : (
                        <span>Error al editar el Producto:</span>
                        <ul class="mb-0">
                            {inputErrors.id &&
                                inputErrors.id.map((error) => (
                                    <li> {error}</li>
                                ))}
                            {inputErrors.type &&
                                inputErrors.type.map((error) => (
                                    <li> {error}</li>
                                ))}
                        </ul>
                    )}
            </Alert>
        )
    }
    {
        result && result.data && (
            <Alert type="success">{name} fue actualuzado exitosamente!!</Alert>
        )
    }
    <form
        action={actions.item.edit}
        method="POST"
        class="needs-validation"
        novalidate
    >
        <div class="row">
            <input type="hidden" name="id" value={parseId} />
            <input type="hidden" name="type" value={"product" as ItemType} />
            <div class="col-12 col-md-6">
                <FieldText
                    label="Nombre"
                    type="text"
                    name="name"
                    min="5"
                    max="250"
                    value={name}
                    required
                    errors={inputErrors.name}
                />
                <FieldText
                    label="Costo"
                    type="number"
                    name="cost"
                    min="0.00"
                    step="0.01"
                    value={cost}
                    required
                    errors={inputErrors.cost}
                />
                <FieldText
                    label="Precio de Venta"
                    type="number"
                    name="sellingPrice"
                    min="0.00"
                    step="0.01"
                    value={sellingPrice}
                    errors={inputErrors.sellingPrice}
                />
            </div>
            <div class="col-12 col-md-6">
                <FieldText
                    label="Stock"
                    type="number"
                    name="stock"
                    min="1"
                    value={parseFloat(stock)}
                    required
                    errors={inputErrors.stock}
                />
                <FieldText
                    label="Stock minimo"
                    type="number"
                    name="minStock"
                    min="1"
                    value={parseFloat(minStock)}
                    errors={inputErrors.minStock}
                />
                <SelectField
                    label="Unidad de medida"
                    name="measureUnitId"
                    errors={inputErrors.measureUnitId}
                    options={measureUnits.map(({ id, name }) => ({
                        value: id,
                        text: name,
                        selected: id === measureUnitId
                    }))}
                />
            </div>

            <div class="d-grid">
                <button
                    type="submit"
                    class="btn btn-success mx-auto"
                    style="width: 35%;">Registrar</button
                >
            </div>
        </div>
    </form>
</Layout>
